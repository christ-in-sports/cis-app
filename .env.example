# Copy to .env.local and fill in. Never commit real values.

# Supabase (local stack: `npx supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by servant signup and the parent join link.
SUPABASE_SERVICE_ROLE_KEY=

# Shared codes. Anyone holding one can sign up, so keep each to its own group chat
# and change it if it leaks (changing it retires every old link).
# Servants: typed on /signup. Creates an account with no role; an Admin grants roles.
SERVANT_SIGNUP_CODE=
# Parents: goes in the link posted in the parent group chat, /join?code=<this>.
# Anyone with it becomes a Parent. Make it long and random: `openssl rand -hex 12`
PARENT_JOIN_CODE=

# Email sent by the app itself (the servant confirmation). Sign-in codes are sent
# by Supabase Auth, which needs its own SMTP settings in the Supabase dashboard.
RESEND_API_KEY=
EMAIL_FROM=
